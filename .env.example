# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=xlent_compliance
POSTGRES_USER=xlent
POSTGRES_PASSWORD=xlent_dev_password
DATABASE_URL=postgresql+asyncpg://xlent:xlent_dev_password@postgres:5432/xlent_compliance

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PRIMARY_PROVIDER=anthropic
LLM_PRIMARY_MODEL=claude-sonnet-4-20250514
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-4o

# Storage
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=25

# Confidence routing
CONFIDENCE_THRESHOLD=0.8

# Pipeline
AUTO_EXTRACT_AFTER_PARSE=true
EXTRACTION_TIMEOUT_SECONDS=180
AUTO_SCREEN_AFTER_EXTRACT=true
API_RELOAD=false
SCREENING_WATCHDOG_ENABLED=true
SCREENING_WATCHDOG_STALE_MINUTES=3
SCREENING_WATCHDOG_BATCH_SIZE=20
SCREENING_WATCHDOG_INTERVAL_MINUTES=1
USE_CELERY_BACKGROUND=true
YENTE_UPDATE_TOKEN=dev-yente-update-token
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
SCREENING_MATCH_THRESHOLD=0.70
SCREENING_CONFIRMED_THRESHOLD=0.79

# Shipment map geocoding
GEOCODE_PROVIDER=nominatim
GEOCODE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_TIMEOUT_SECONDS=12
GEOCODE_USER_AGENT=xlent-compliance/0.1 (contact: compliance@xlent.no)
GEOCODE_MAX_EXTERNAL_LOOKUPS_PER_REQUEST=20

# CORS (kommaseparert liste)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
